{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vbirr-preview",
  "main": "./worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VBIRR_WORKSPACE",
        "class_name": "VBirrWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VBirrWorkspace"]
    }
  ]
}
